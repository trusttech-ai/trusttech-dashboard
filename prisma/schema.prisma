generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  password     String
  name         String?
  role         Role          @default(USER)
  isActive     Boolean       @default(true)
  profileImage String?
  lastLogin    DateTime?
  refreshToken String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  document     String?       @unique
  sessions     Session[]
  uploadLogs   UploadLog[]
  settings     UserSettings?
}

model Session {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id                 Int     @id @default(autoincrement())
  userId             Int     @unique
  theme              String  @default("light")
  emailNotifications Boolean @default(true)
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UploadLog {
  id              String            @id @default(uuid())
  fileName        String
  fileType        String?
  fileSize        Int?
  filePath        String?
  ipAddress       String?
  userAgent       String?
  status          FileApproveStatus @default(PENDING)
  errorMessage    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  uploadedBy      Int?
  approvalActions ApprovalAction[]
  user            User?             @relation(fields: [uploadedBy], references: [id])
}

model ApprovalAction {
  id        String    @id @default(uuid())
  fileName  String
  filePath  String
  action    String
  comment   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userId    String
  logId     String
  uploadLog UploadLog @relation(fields: [logId], references: [id])
}

model trusttech_messages_log {
  id           String    @id @default(uuid()) @db.Uuid
  user_number  String?   @db.VarChar(25)
  user_name    String?
  user_message String?
  bot_response String?
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  updated_at   DateTime? @default(now()) @updatedAt @db.Timestamp(6)
  host_name    String?   @db.VarChar(25)
  host_number  String?   @db.VarChar(25)
}

model trusttech_rewind_cron {
  id          String   @id @default(uuid()) @db.Uuid
  user_number String   @db.VarChar(25)
  active      Boolean
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  host_name   String?  @db.VarChar(25)
  host_number String?  @db.VarChar(25)
  user_name   String?  @db.VarChar(25)
}

model MessagesLog {
  id           String    @id @db.Uuid
  host_number  String?   @db.VarChar(25)
  host_name    String?   @db.VarChar(25)
  user_number  String?   @db.VarChar(25)
  user_name    String?
  user_message String?
  bot_response String?
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  updated_at   DateTime? @default(now()) @db.Timestamp(6)
}

model RewindCron {
  id          String   @id @db.Uuid
  host_name   String?  @db.VarChar(25)
  host_number String?  @db.VarChar(25)
  user_number String   @db.VarChar(25)
  user_name   String?  @db.VarChar(25)
  active      Boolean
  created_at  DateTime @default(now())
  updated_at  DateTime
}

enum Role {
  USER
  ADMIN
  MANAGER
}

enum FileApproveStatus {
  APPROVED
  REJECTED
  PENDING
  FAILED
}
